{
    "name": "showbiz",
    "displayName": "Showbiz",
    "description": "Adds some utilities for working with the Showbiz Minecraft mod",
    "version": "1.2.1",
    "engines": {
        "vscode": "^1.105.0"
    },
    "icon": "./icon.webp",
    "publisher": "FlooferLand",
    "repository": {
        "type": "github",
        "url": "https://github.com/FlooferLand/showbiz-vscode"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [],
        "languages": [
            {
                "id": "bitsmap",
                "aliases": [
                    "Bitsmap"
                ],
                "extensions": [
                    ".bits"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "bitsmap",
                "scopeName": "source.bitsmap",
                "path": "./syntaxes/bitsmap.tmLanguage.json"
            }
        ],
        "configuration": [
            {
                "title": "Showbiz",
                "properties": {
                    "showbiz.javaPath": {
                        "type": "string",
                        "default": "",
                        "description": "Either an executable or a value similar to JAVA_HOME"
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "postcompile": "cpx \"data/**/*\" out/data",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "publish": "vsce package && vsce publish"
    },
    "devDependencies": {
        "@types/node": "22.x",
        "@types/vscode": "^1.105.0",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "cpx2": "^9.0.3",
        "eslint": "^9.36.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@vscode/vsce": "^4.0.0",
        "vscode-languageclient": "^10.1.2"
    }
}
